# Development database bootstrap. Use different local passwords per role.
BASE_DB_BOOTSTRAP_USER=base_ielts_bootstrap
BASE_DB_BOOTSTRAP_PASSWORD=
BASE_DB_NAME=base_ielts
BASE_DB_PORT=5432
BASE_DB_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/base_ielts
# The migration and runtime roles are provisioned in M1.2/M1.3.
BASE_DB_MIGRATION_USER=base_ielts_migration
BASE_DB_MIGRATION_PASSWORD=
BASE_DB_RUNTIME_USER=base_ielts_runtime
BASE_DB_RUNTIME_PASSWORD=
BASE_BACKEND_PORT=8080
# Export these only for a controlled local backend process. Compose does not export app variables.
BASE_IDENTITY_ENABLED=false
BASE_IDENTITY_VERIFICATION_CAPTURE=false
